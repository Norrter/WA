# Скопируйте этот файл в .env и подставьте свои значения.

# Подключение к базе (совпадает с docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://workout_user:workout_password@localhost:5432/workout_db

# Секрет для подписи токенов, минимум 16 символов.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=замените-на-длинную-случайную-строку

# Необязательные настройки (показаны значения по умолчанию)
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=30
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# SQL_ECHO=false

# Тренеры: видят статистику всех пользователей. Email через запятую,
# аккаунты нужно сначала зарегистрировать
# COACH_EMAILS=coach@example.com
