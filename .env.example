# Скопируйте этот файл в .env и подставьте свои значения.

# Подключение к базе (совпадает с docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://workout_user:workout_password@localhost:5432/workout_db

# Секрет для подписи токенов, минимум 16 символов.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=замените-на-длинную-случайную-строку

# Необязательные настройки (показаны значения по умолчанию)
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=30
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# SQL_ECHO=false

# Тренеры: видят статистику всех пользователей. Email через запятую,
# аккаунты нужно сначала зарегистрировать
# COACH_EMAILS=coach@example.com

# Администраторы: админ-панель со всеми данными. Email через запятую,
# аккаунты нужно сначала зарегистрировать
# ADMIN_EMAILS=me@example.com
# Пороги меток клиентов в кабинете тренера (показаны значения по умолчанию)
# COACH_INACTIVE_DAYS=5
# COACH_ADHERENCE_THRESHOLD=0.7
# COACH_STAGNATION_DAYS=28

# ----- Почта: подтверждение адреса и письма о новых заявках -----
# Пока SMTP_HOST пустой, письма печатаются в консоль сервера.
# Пример для Яндекс Почты (нужен пароль приложения, см. README):
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_USER=greeks.gym@yandex.ru
# SMTP_PASSWORD=пароль-приложения
# SMTP_FROM=greeks.gym@yandex.ru
# SMTP_FROM_NAME=Greek's Gym
#
# Адрес сайта — из него собираются ссылки в письмах
# FRONTEND_URL=http://localhost:5173
# Сколько часов действует ссылка подтверждения
# EMAIL_VERIFY_HOURS=48
# Куда слать новые заявки (через запятую). Пусто — на COACH_EMAILS
# LEAD_NOTIFY_EMAILS=coach@example.com
